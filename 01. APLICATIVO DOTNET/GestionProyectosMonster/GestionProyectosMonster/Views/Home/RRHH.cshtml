@{
    ViewData["Title"] = "Panel RR. HH.";
    int totalEmp = ViewBag.TotalEmpleados ?? 0;
    int totalDep = ViewBag.TotalDepartamentos ?? 0;
}

<div class="page-heading">
    <div>
        <h1>Recursos Humanos</h1>
        <p>Bienvenido, @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</p>
    </div>
</div>

<!-- Estadísticas -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:24px">
    <div class="card card-padded" style="text-align:center">
        <p style="font-size:12px;color:var(--tx-3);margin-bottom:4px">Total empleados</p>
        <strong style="font-size:32px;color:var(--brand)">@totalEmp</strong>
    </div>
    <div class="card card-padded" style="text-align:center">
        <p style="font-size:12px;color:var(--tx-3);margin-bottom:4px">Departamentos</p>
        <strong style="font-size:32px;color:var(--brand)">@totalDep</strong>
    </div>
</div>

<div class="module-grid">
    <a class="module-card" asp-controller="Empleado" asp-action="Index">
        <div class="card-content">
            <div class="module-icon">👤</div>
            <h2>Gestión de Personal</h2>
            <p>@totalEmp empleado(s) registrado(s)</p>
        </div>
    </a>
    <a class="module-card" asp-controller="Empleado" asp-action="Organigrama">
        <div class="card-content">
            <div class="module-icon">🌳</div>
            <h2>Organigrama</h2>
            <p>Árbol jerárquico por departamento y cargo</p>
        </div>
    </a>
    <a class="module-card" asp-controller="Reporte" asp-action="Index">
        <div class="card-content">
            <div class="module-icon">📄</div>
            <h2>Reporte de Personal</h2>
            <p>Reporte imprimible / exportar PDF</p>
        </div>
    </a>
</div>

<div class="card form-card" style="margin-top:24px">
    <h2>Acceso rápido</h2>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:12px">
        <a asp-controller="Account" asp-action="CambiarClave" class="btn btn-secondary">
            Cambiar mi contraseña
        </a>
        <a asp-controller="Empleado" asp-action="Organigrama" class="btn btn-secondary">
            Ver organigrama
        </a>
    </div>
</div>
