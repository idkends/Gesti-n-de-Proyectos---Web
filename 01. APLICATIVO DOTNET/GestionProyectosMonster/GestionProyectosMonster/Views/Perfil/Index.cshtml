@using GestionProyectosMonster.Models
@{
    ViewData["Title"] = "Gestión de Perfiles";
    var perfiles      = ViewBag.Perfiles      as List<Perfil> ?? [];
    string proximoCodigo = ViewBag.ProximoCodigo ?? "...";
    var perfilEditar  = ViewBag.PerfilEditar   as Perfil;
    bool editando     = perfilEditar != null;
}

<div class="page-heading">
    <div>
        <p style="font-size:12px;color:var(--tx-3);margin-bottom:4px">Módulo de Seguridad</p>
        <h1>Gestión de Perfiles</h1>
        <p>Crea y administra los perfiles de seguridad del sistema</p>
    </div>
    <a asp-controller="Perfil" asp-action="AsignarOpciones" class="btn btn-secondary">
        Asignar Opciones →
    </a>
</div>

<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:20px;align-items:start">

    <!-- ── Formulario ──────────────────────────────────────────── -->
    <div class="card form-card">
        <h2>@(editando ? "Editar perfil" : "Nuevo perfil")</h2>

        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="codigoOriginal" value="@(editando ? perfilEditar!.Codigo : "")" />

            <div class="field">
                <label>Código</label>
                @if (editando)
                {
                    <span class="code-badge" style="font-size:13px;padding:6px 14px">@perfilEditar!.Codigo</span>
                }
                else
                {
                    <p style="font-size:12px;color:var(--tx-3);margin-top:4px">
                        Se asignará automáticamente: <strong style="color:var(--brand)">@proximoCodigo</strong>
                    </p>
                }
            </div>

            <div class="field">
                <label>Descripción <span class="req">*</span></label>
                <input name="descripcion" type="text" maxlength="100"
                       value="@(editando ? perfilEditar!.Descripcion : "")"
                       placeholder="Ej. Analista de Sistemas" required />
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary">
                    @(editando ? "Actualizar" : "Crear Perfil")
                </button>
                @if (editando)
                {
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                }
            </div>
        </form>
    </div>

    <!-- ── Listado ─────────────────────────────────────────────── -->
    <div class="card table-card">
        <h2 style="padding:16px 20px 0">Perfiles registrados</h2>

        @if (!perfiles.Any())
        {
            <p class="muted" style="padding:20px">Sin perfiles registrados.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                        <th>Asignar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in perfiles)
                    {
                        <tr>
                            <td><span class="code-badge">@p.Codigo</span></td>
                            <td>@p.Descripcion</td>
                            <td class="actions">
                                <a asp-action="Index" asp-route-codigo="@p.Codigo"
                                   class="btn btn-sm btn-secondary">Editar</a>

                                <form asp-action="Eliminar" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="codigo" value="@p.Codigo" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('¿Eliminar el perfil @p.Codigo?')">
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a asp-controller="Usuario" asp-action="AsignarPerfil"
                                   class="btn btn-sm btn-secondary" title="Asignar usuarios">
                                    Usuarios
                                </a>
                                <a asp-action="AsignarOpciones" asp-route-perfilCodigo="@p.Codigo"
                                   class="btn btn-sm btn-secondary" title="Asignar opciones de menú">
                                    Opciones
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p style="padding:10px 20px;font-size:12px;color:var(--tx-3)">
                Haz clic en <strong>Opciones</strong> para asignar las pantallas visibles a cada perfil.
                Haz clic en <strong>Usuarios</strong> para asignar colaboradores.
            </p>
        }
    </div>

</div>
