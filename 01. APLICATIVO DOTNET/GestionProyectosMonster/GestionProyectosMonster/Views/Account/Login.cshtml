@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — Gestión Monster</title>
    <link rel="stylesheet" href="~/css/estilos.css" />
</head>
<body class="login-body">

<div class="login-shell">

    <div class="login-brand">
        <div class="login-logo">
            <img src="~/recursos/Sullivan.png" alt="Monster" class="login-logo-img" />
        </div>
        <div class="login-brand-text">
            <strong>Monster</strong>
            <span>Gestión de Proyectos</span>
        </div>
    </div>

    <div class="login-card">
        <h1>Iniciar sesión</h1>
        <p>Ingresa con tu código y contraseña de empleado</p>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert alert-error" style="margin-top:20px">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Account"
              style="margin-top:24px;display:flex;flex-direction:column;gap:16px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="field">
                <label for="codigo">Código de Empleado</label>
                <input id="codigo" name="codigo" type="text"
                       placeholder="EMP001" autocomplete="username"
                       required autofocus />
            </div>

            <div class="field">
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password"
                       placeholder="••••••••••••"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="margin-top:4px;height:42px;font-size:14px">
                Ingresar →
            </button>
        </form>

        <div class="login-footer">
            Grupo 06 — Ingeniería de Software
        </div>
    </div>

</div>

</body>
</html>
